{
  "name": "flickme-admin",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:check": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src vite.config.ts tsconfig.json package.json",
    "format:check": "prettier --check src vite.config.ts tsconfig.json package.json"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "element-plus": "2.14.7",
    "pinia": "3.0.4",
    "vue": "3.5.44",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@types/node": "22.19.4",
    "@vitejs/plugin-vue": "6.0.10",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "unplugin-auto-import": "21.1.0",
    "unplugin-vue-components": "32.1.0",
    "vite": "7.3.7",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
